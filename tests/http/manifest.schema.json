{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperclay.local/tests/http/manifest.schema.json",
  "title": "Host HTTP fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hostBuild", "roots", "documents", "control", "expectedProfile"],
  "properties": {
    "schema": { "const": 1 },
    "hostBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "fixtureRoot"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
          "fixtureRoot": { "type": "string", "minLength": 1 }
        }
      }
    },
    "documents": { "type": "array" },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "token"],
      "properties": {
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
        "token": { "type": "string", "pattern": "^[0-9a-f]{48}$" }
      }
    },
    "expectedProfile": { "type": "string", "minLength": 1 }
  }
}
